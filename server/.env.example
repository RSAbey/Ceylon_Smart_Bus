# Copy to .env and fill in. Never commit .env, and never put real credentials in this example file.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ceylon_smart_bus
JWT_SECRET=<long-random-string>
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins (admin dashboard URLs)
CLIENT_ORIGINS=http://localhost:5173

# Resend (https://resend.com) sends the 6-digit password-reset code by email. Optional in
# development: with no key the code comes back in the API response instead, which is how the team
# tests without a mailbox. RESEND_FROM_EMAIL must be on a domain verified in Resend; left empty the
# shared sender onboarding@resend.dev is used, which only delivers to the Resend account's own owner.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
