# Copy to .env and fill in. Never commit .env.
#
# EXPO_PUBLIC_API_URL is OPTIONAL during development.
# Leave it unset and the app derives the API address from the Expo dev server host, so it keeps
# working when your laptop's Wi-Fi IP changes. Set it only to point at a different machine or a
# deployed API (EAS builds get it from eas.json).
# EXPO_PUBLIC_API_URL=http://192.168.8.101:5000/api

# No Google Maps key is needed. The maps are drawn with Leaflet over OpenStreetMap tiles inside a
# WebView (mobile/src/features/tracking/components/RouteMap.js), which needs no key and no account.
# Only if the team switches back to react-native-maps does a GOOGLE_MAPS_API_KEY belong here, and
# then it has to be in a development build or an APK — Expo Go ignores it.
