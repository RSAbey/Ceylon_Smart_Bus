# Copy to .env and fill in. Never commit .env.
# Phone testing: use your laptop's LAN IP (not localhost); phone and laptop on the same Wi-Fi.
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api
# Google Maps SDK for Android key (needed for the map in a built APK; set as an EAS secret for builds)
GOOGLE_MAPS_API_KEY=
