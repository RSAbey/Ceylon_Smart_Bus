# Copy to .env and fill in. Never commit .env.
#
# EXPO_PUBLIC_API_URL is OPTIONAL during development.
# Leave it unset and the app derives the API address from the Expo dev server host, so it keeps
# working when your laptop's Wi-Fi IP changes. Set it only to point at a different machine or a
# deployed API (EAS builds get it from eas.json).
# EXPO_PUBLIC_API_URL=http://192.168.8.101:5000/api

# Google Maps SDK for Android key. Without it the map is a blank/black box with the Google logo in
# the corner, on the driver Live screen and on passenger live tracking.
#   1. Google Cloud console -> new project -> enable "Maps SDK for Android"
#   2. Credentials -> create an API key -> paste it below (and set it as an EAS secret for builds)
# It reaches the app through app.config.js -> android.config.googleMaps.apiKey, which only applies to
# an app that is BUILT from this config: a development build (npx expo run:android) or an APK.
# Expo Go runs with its own configuration, so the map can stay blank there whatever is set here.
GOOGLE_MAPS_API_KEY=
